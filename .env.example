# Copy to .env. Secrets live here only; they are never stored in the database or logged.
# No keys are needed for the demo.

# Optional overrides (the older CTM_* names are still read)
# SOCIALARB_DATA_DIR=./data
# SOCIALARB_DATABASE_URL=sqlite:///./data/socialarb.db
# SOCIALARB_CONFIG=./config/settings.yaml
# SOCIALARB_BACKUP_DIR=./backups

# Live sources. Set a source's mode to `live` in config/settings.yaml to use these.
# The live adapters are stubs today: with a key set they skip with "not built yet".
# TRENDS_PROVIDER_API_KEY=        # search_interest, ticker_search_interest
# YOUTUBE_API_KEY=                # social_mentions
# PRICE_VENDOR_API_KEY=           # price
# EARNINGS_CALENDAR_API_KEY=      # earnings (live mode; csv mode needs no key)
# X_BEARER_TOKEN=                 # cashtag_mentions
