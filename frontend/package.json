{
  "name": "trend-monitor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "cd ../backend && ctm openapi --out ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "openapi-typescript": "7.4.1",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  }
}
